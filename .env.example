# Azure Blob Storage - fill in after creating Storage Account
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=photos

# Azure Cosmos DB - fill in after creating Cosmos DB account
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=bagdadipics
COSMOS_CONTAINER=photos

# Application Insights - fill in after creating App Insights resource
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Auth - JWT signing secret. Generate with: openssl rand -base64 48
JWT_SECRET=

# App
PORT=3000
